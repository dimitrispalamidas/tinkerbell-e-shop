SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Viva Wallet (Get your credentials from https://www.vivawallet.com/en-gr/business)
# Demo API: https://demo-api.vivapayments.com
# Live API: https://api.vivapayments.com
VIVA_API_URL=https://demo-api.vivapayments.com
VIVA_CLIENT_ID=your_client_id_here
VIVA_CLIENT_SECRET=your_client_secret_here
VIVA_SOURCE_CODE=your_source_code_here
VIVA_WEBHOOK_KEY=your_webhook_verification_key_here

# Resend (Email service for order confirmations)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# OneSignal (Push notifications for admin)
# Get your credentials from https://app.onesignal.com
#
# OPTION 1: Same app for dev and production (simple)
# ONESIGNAL_APP_ID=your_onesignal_app_id_here
# ONESIGNAL_REST_API_KEY=your_rest_api_key_here
# NEXT_PUBLIC_ONESIGNAL_APP_ID=your_onesignal_app_id_here
#
# OPTION 2: Separate apps for dev and production (recommended)
# Development (localhost):
ONESIGNAL_APP_ID_DEV=your_dev_app_id_here
ONESIGNAL_REST_API_KEY_DEV=your_dev_rest_api_key_here
NEXT_PUBLIC_ONESIGNAL_APP_ID_DEV=your_dev_app_id_here
# Production:
ONESIGNAL_APP_ID_PROD=your_prod_app_id_here
ONESIGNAL_REST_API_KEY_PROD=your_prod_rest_api_key_here
NEXT_PUBLIC_ONESIGNAL_APP_ID_PROD=your_prod_app_id_here

# App Config
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# SEO & Google
# Get verification code from https://search.google.com/search-console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_verification_code_here

